<!-- SpotBugs project decisions: a rule, or a rule in part of the code, that the team has decided not
     to enforce. One Match per decision, with a comment giving the reason, for example:

       <!- - JPA entities share associations by design (reason ...) - ->
       <Match><Package name="~team\.projectpulse\..*"/><Bug pattern="EI_EXPOSE_REP"/></Match>

     Unlike the baseline, this file may grow, but every entry is a reviewed decision. -->
<FindBugsFilter>
    <!-- D1: Single-valued JPA associations intentionally share mutable entity references to
         preserve entity identity and support relationship management. Accept this design risk
         for @ManyToOne and @OneToOne only; collection associations and other references remain
         subject to EI_EXPOSE_REP and EI_EXPOSE_REP2. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Or>
            <Annotation name="jakarta.persistence.ManyToOne"/>
            <Annotation name="jakarta.persistence.OneToOne"/>
        </Or>
    </Match>

